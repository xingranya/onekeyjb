      <id>ItosEO</id>
      <name>ItosEO</name>
      <url>https://github.com/ItosEO</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/ItosEO/COUI-Kit.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/ItosEO/COUI-Kit.git</developerConnection>
    <url>https://github.com/ItosEO/COUI-Kit</url>
  </scm>
  <dependencies>
