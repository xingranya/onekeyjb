  <artifactId>coui</artifactId>
  <version>0.0.1-alpha17</version>
  <packaging>aar</packaging>
  <name>COUI-Kit</name>
  <description>面向 Android Jetpack Compose 的 COUI 组件与视觉效果库</description>
